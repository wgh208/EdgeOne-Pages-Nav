# 必填：管理员登录密码（至少 8 个字符）
ADMIN_PASSWORD=

# 必填：JWT 签名密钥（至少 32 个字符，建议随机生成）
JWT_SECRET=

# 可选：数据 key 前缀 / 用户标识，默认 testUser
DEFAULT_USER=testUser

# 可选：允许跨域的来源，多个用英文逗号分隔；留空表示不限制
ALLOWED_ORIGINS=

# 可选：图标 API 前缀
ICON_API=https://api.xinac.net/icon/?url=

# 可选：true = 浏览器直连图标 API；false = 使用 /api/icon 代理
PREFER_ICON_API=true
